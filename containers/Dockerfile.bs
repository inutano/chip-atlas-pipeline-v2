# ChIP-Atlas Pipeline v2: Bisulfite-seq container
#
# Contains DNMTools + samtools + UCSC tools for the WGBS pipeline.
# Tool versions are pinned for reproducibility.
#
# Build:
#   docker build -t ghcr.io/inutano/chip-atlas-pipeline-v2-bs:v1.2.0 \
#     -t ghcr.io/inutano/chip-atlas-pipeline-v2-bs:latest \
#     -f containers/Dockerfile.bs containers/
#
FROM condaforge/mambaforge:latest

LABEL org.opencontainers.image.source="https://github.com/inutano/chip-atlas-pipeline-v2"
LABEL org.opencontainers.image.description="ChIP-Atlas Pipeline v2 BS-seq container (DNMTools + samtools + UCSC tools + deeptools)"
LABEL org.opencontainers.image.version="1.2.0"

# Note: dnmtools 1.5.1 requires htslib <1.23, which constrains samtools to
# 1.22.x. samtools 1.23.1 (CVE-2026-31973 fix) cannot coexist. The CVE is a
# CRAM header validation issue — this pipeline uses BAM only, so not affected.
# Bump samtools when a future dnmtools release supports htslib >=1.23.
RUN mamba install -y -c bioconda -c conda-forge \
    dnmtools=1.5.1 \
    samtools=1.22.1 \
    ucsc-bedgraphtobigwig=482 \
    fastp=1.3.1 \
    deeptools=3.5.6 \
    && mamba clean -afy

RUN printf '#!/bin/bash\n\
echo "dnmtools $(dnmtools 2>&1 | grep -i version | head -1)"\n\
echo "samtools $(samtools --version | head -1)"\n\
echo "bedGraphToBigWig $(bedGraphToBigWig 2>&1 | head -1)"\n\
echo "fastp $(fastp --version 2>&1 | head -1)"\n\
echo "deeptools $(multiBigwigSummary --version 2>&1)"\n' > /usr/local/bin/versions.sh \
    && chmod +x /usr/local/bin/versions.sh

RUN versions.sh

ENTRYPOINT []
CMD ["/bin/bash"]
