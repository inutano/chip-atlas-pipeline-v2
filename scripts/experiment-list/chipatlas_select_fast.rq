  VALUES (?library_strategy ?library_selection) {
    (dra_ont:ChIP-Seq                dra_ont:ChIP)
    (dra_ont:ChIP-Seq                dra_ont:DNase)
    (dra_ont:DNase-Hypersensitivity  dra_ont:ChIP)
    (dra_ont:DNase-Hypersensitivity  dra_ont:DNase)
    (dra_ont:ATAC-seq                dra_ont:PCR)
    (dra_ont:ATAC-seq                dra_ont:other)
    (dra_ont:Bisulfite-Seq           dra_ont:RANDOM)
  }
  VALUES ?library_source { dra_ont:GENOMIC }

  ?exp a dra_ont:Experiment ;
       dct:identifier ?srx ;
       dra_ont:platform ?pl ;
       dra_ont:design ?d ;
       rdfs:seeAlso ?bs .
  ?pl a dra_ont:ILLUMINA .
  ?d dra_ont:libraryStrategy  ?library_strategy ;
     dra_ont:librarySelection ?library_selection ;
     dra_ont:librarySource    ?library_source .

  ?bs a biosample_ont:BioSampleRecord ;
      dct:identifier ?samn ;
      rdfs:seeAlso ?taxIRI ;
      biosample_ont:taxonomyName ?taxonomy_name .

  OPTIONAL { ?exp dra_ont:title ?title }
  OPTIONAL { ?pl dra_ont:instrumentModel ?instrument_model }
  OPTIONAL {
    ?exp rdfs:seeAlso ?srpIRI .
    ?srpIRI a dra_ont:Study ; dct:identifier ?srp .
  }
  OPTIONAL {
    ?exp rdfs:seeAlso ?prjIRI .
    ?prjIRI a bioproject_ont:BioProjectRecord ; dct:identifier ?prj .
  }
}
